[
  {
    "meta": {
      "id": "suzuke.3dgs-su",
      "legacyId": "Suzuke.3DGS_Su",
      "packageType": "script",
      "packageRole": "primaryPackage",
      "addedAt": "2026-11-14",
      "packagePageUrl": "https://github.com/Suzukeh/3DGS_Su"
    },
    "content": {
      "name": "3DGS_Su",
      "author": "Suzuke",
      "tags": [
        "3D",
        "3DGS",
        "点群",
        "ガウシアンスプラッティング",
        "カメラ制御"
      ],
      "typeLabel": "スクリプト",
      "description": {
        "summary": "3DGSのPLY/SOGを3D空間にカメラ同期で表示",
        "markdownSource": "https://raw.githubusercontent.com/Suzukeh/3DGS_Su/main/README.md"
      },
      "licenses": [
        {
          "type": "MIT",
          "copyrights": [
            {
              "years": "2026",
              "holder": "Suzuke"
            }
          ]
        }
      ],
      "images": {
        "thumbnail": "image/Suzuke.3DGS_Su_thumbnail.png",
        "detailImages": [
          "image/Suzuke.3DGS_Su_preview.png"
        ]
      }
    },
    "install": {
      "installation": {
        "source": {
          "type": "githubRelease",
          "owner": "Suzukeh",
          "repo": "3DGS_Su",
          "pattern": "^3DGS_Su-v.*.zip$"
        },
        "installSteps": [
          {
            "action": "download"
          },
          {
            "action": "extract"
          },
          {
            "action": "copy",
            "from": "{tmp}/Script/3DGS_Su.obj2",
            "to": "{scriptsDir}/3DGS_Su"
          },
          {
            "action": "copy",
            "from": "{tmp}/Script/3DGS_Su_atlas.png",
            "to": "{scriptsDir}/3DGS_Su"
          },
          {
            "action": "copy",
            "from": "{tmp}/Script/README.md",
            "to": "{scriptsDir}/3DGS_Su"
          },
          {
            "action": "copy",
            "from": "{tmp}/Plugin/3DGSConverter_Su/three_dgs_converter_su.aux2",
            "to": "{pluginsDir}/3DGSConverter_Su"
          },
          {
            "action": "copy",
            "from": "{tmp}/Plugin/3DGSConverter_Su/su3ds.exe",
            "to": "{pluginsDir}/3DGSConverter_Su"
          }
        ],
        "uninstallSteps": [
          {
            "action": "delete",
            "path": "{scriptsDir}/3DGS_Su/3DGS_Su.obj2"
          },
          {
            "action": "delete",
            "path": "{scriptsDir}/3DGS_Su/3DGS_Su_atlas.png"
          },
          {
            "action": "delete",
            "path": "{scriptsDir}/3DGS_Su/README.md"
          },
          {
            "action": "delete",
            "path": "{pluginsDir}/3DGSConverter_Su/three_dgs_converter_su.aux2"
          },
          {
            "action": "delete",
            "path": "{pluginsDir}/3DGSConverter_Su/su3ds.exe"
          }
        ]
      }
    },
    "versions": {
      "versions": [
        {
          "version": "v0.5.2",
          "releaseDate": "2026-11-14",
          "files": [
            {
              "path": "{scriptsDir}/3DGS_Su/3DGS_Su.obj2",
              "xxh128": "519db53d5955fbad4ffb6e8da71b73d2"
            },
            {
              "path": "{scriptsDir}/3DGS_Su/3DGS_Su_atlas.png",
              "xxh128": "2a0e792d9e6819be2c11d14c76b8e29f"
            },
            {
              "path": "{pluginsDir}/3DGSConverter_Su/three_dgs_converter_su.aux2",
              "xxh128": "71b82781364b392bdc8ec18cba1775bb"
            },
            {
              "path": "{pluginsDir}/3DGSConverter_Su/su3ds.exe",
              "xxh128": "43562f866be38a579388e5a465846715"
            }
          ]
        }
      ]
    }
  }
]
